# ==============================================================================
# Configurações do Supabase (Frontend)
# ==============================================================================
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-supabase

# ==============================================================================
# Credenciais da Pluggy (Open Finance)
# Cadastre como Secrets nas Edge Functions do Supabase:
# npx supabase secrets set PLUGGY_CLIENT_ID=xxx PLUGGY_CLIENT_SECRET=xxx
# ==============================================================================
PLUGGY_CLIENT_ID=seu_client_id_da_pluggy
PLUGGY_CLIENT_SECRET=seu_client_secret_da_pluggy
